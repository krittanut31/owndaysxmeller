# Products API (server-only; used by src/lib/api.ts)
PRODUCTS_API_URL=https://api-one-alpha-60.vercel.app/meller/products.json

# Prepended to image `path` values from the API (exposed to the browser)
NEXT_PUBLIC_IMAGE_BASE_URL=https://storage.owndays.com/storage/

# Public site URL for absolute OGP image URLs (optional on Vercel: falls back to the production domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
